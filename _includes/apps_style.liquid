<style>
  .app-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin: 1.5rem 0 2rem; }
  .app-chip { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border: 1px solid var(--global-divider-color); border-radius: 14px; background: var(--global-card-bg-color); color: var(--global-text-color) !important; text-decoration: none !important; transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease; }
  .app-chip:hover { transform: translateY(-2px); border-color: var(--global-theme-color); box-shadow: 0 6px 18px rgba(0,0,0,.08); }
  .app-chip img { width: 52px; height: 52px; border-radius: 12px; flex: none; box-shadow: 0 1px 4px rgba(0,0,0,.15); }
  .app-chip .app-chip-name { font-weight: 600; line-height: 1.2; }
  .app-chip .app-chip-tag { font-size: .85rem; color: var(--global-text-color-light); line-height: 1.3; margin-top: 2px; }
  .app-chip .app-chip-arrow { margin-left: auto; color: var(--global-text-color-light); }
  .app-chip:hover .app-chip-arrow { color: var(--global-theme-color); }

  .app-card { border: 1px solid var(--global-divider-color); border-radius: 18px; background: var(--global-card-bg-color); padding: 24px; margin-bottom: 28px; }
  .app-head { display: flex; gap: 18px; align-items: center; margin-bottom: 14px; }
  .app-head img { width: 84px; height: 84px; border-radius: 19px; flex: none; box-shadow: 0 2px 8px rgba(0,0,0,.15); }
  .app-head h2 { margin: 0; font-size: 1.5rem; }
  .app-head .app-tagline { color: var(--global-text-color-light); margin: 2px 0 0; }
  .app-platforms { font-size: .8rem; color: var(--global-text-color-light); margin-top: 4px; }
  .app-tags { margin: 10px 0 14px; }
  .app-tags span { display: inline-block; font-size: .75rem; padding: 2px 10px; margin: 0 6px 6px 0; border-radius: 999px; border: 1px solid var(--global-divider-color); color: var(--global-text-color-light); }
  .app-links a { display: inline-flex; align-items: center; gap: 8px; padding: 7px 16px; margin: 0 8px 8px 0; border-radius: 999px; background: var(--global-theme-color); color: #fff !important; font-size: .9rem; text-decoration: none !important; }
  .app-links a:hover { opacity: .85; }
  .app-shots { display: flex; gap: 12px; overflow-x: auto; padding: 14px 2px 4px; scroll-snap-type: x mandatory; }
  .app-shots img { height: 380px; max-width: 70vw; object-fit: cover; border-radius: 16px; border: 1px solid var(--global-divider-color); scroll-snap-align: start; flex: none; }
  html[data-theme="dark"] .app-chip,
  html[data-theme="dark"] .app-card { background: #26272b; border-color: #3d3e44; }
  html[data-theme="dark"] .app-chip .app-chip-tag,
  html[data-theme="dark"] .app-head .app-tagline,
  html[data-theme="dark"] .app-platforms,
  html[data-theme="dark"] .app-chip .app-chip-arrow { color: #c4c6cc; }
  html[data-theme="dark"] .app-card p { color: #e6e7ea; }
  html[data-theme="dark"] .app-head h2,
  html[data-theme="dark"] .app-chip .app-chip-name { color: #ffffff !important; }
  html[data-theme="dark"] .app-tags span { color: #d2d4d9; border-color: #5a5c63; }
  html[data-theme="dark"] .app-links a { background: var(--global-theme-color); color: #1c1c1d !important; font-weight: 600; }
  html[data-theme="dark"] .app-chip:hover { box-shadow: 0 6px 18px rgba(0,0,0,.45); }
  html[data-theme="dark"] .app-chip img,
  html[data-theme="dark"] .app-head img { box-shadow: 0 0 0 1px rgba(255,255,255,.08); }
  @media (max-width: 576px) { .app-card { padding: 18px; } .app-shots img { height: 300px; } }
</style>
